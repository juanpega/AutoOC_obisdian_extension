{
  "name": "auto-oc",
  "version": "1.5.11",
  "description": "Schedule and run OpenCode CLI tasks and visual workflows from Obsidian",
  "main": "main.js",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "prebuild": "node scripts/inline-visual-builder.mjs",
    "predev": "node scripts/inline-visual-builder.mjs",
    "inline-vb": "node scripts/inline-visual-builder.mjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && node deploy.mjs",
    "pack:release": "node scripts/package-release.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.21.5",
    "obsidian": "latest",
    "tslib": "2.6.0",
    "typescript": "^5.0.0"
  }
}
